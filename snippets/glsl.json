{
  "TouchDesigner GLSL TOP Pixel Shader": {
    "prefix": "td-glsl-top",
    "body": [
      "// TouchDesigner GLSL TOP Pixel Shader",
      "",
      "uniform float uTime;",
      "",
      "out vec4 fragColor;",
      "",
      "void main()",
      "{",
      "\t// Normalized UV coordinates [0.0, 1.0]",
      "\tvec2 uv = vUV.st;",
      "",
      "\t// Sample input texture 0",
      "\tvec4 inColor = texture(sTD2DInputs[0], uv);",
      "",
      "\t// Shading logic",
      "\tvec4 color = inColor;",
      "",
      "\t// TDOutputSwizzle applies color swizzling and pre-multiplication",
      "\tfragColor = TDOutputSwizzle(color);",
      "}",
      ""
    ],
    "description": "TouchDesigner GLSL TOP fragment shader template"
  },
  "TouchDesigner GLSL TOP Multi-Input": {
    "prefix": "td-glsl-multi",
    "body": [
      "out vec4 fragColor;",
      "",
      "void main()",
      "{",
      "\tvec2 uv = vUV.st;",
      "\tvec4 color0 = texture(sTD2DInputs[0], uv);",
      "\tvec4 color1 = texture(sTD2DInputs[1], uv);",
      "",
      "\tvec4 result = mix(color0, color1, ${1:0.5});",
      "\tfragColor = TDOutputSwizzle(result);",
      "}",
      ""
    ],
    "description": "TouchDesigner 2-input blend GLSL shader"
  },
  "TouchDesigner GLSL MAT Vertex Shader": {
    "prefix": "td-glsl-vert",
    "body": [
      "out Vertex",
      "{",
      "\tvec4 color;",
      "\tvec3 worldSpacePos;",
      "\tvec3 worldSpaceNorm;",
      "\tvec2 uv;",
      "} oVert;",
      "",
      "void main()",
      "{",
      "\t// TDDeform applies instancing and bone transforms",
      "\tvec4 worldSpacePos = TDDeform(P);",
      "\tgl_Position = TDWorldToProj(worldSpacePos);",
      "",
      "\toVert.worldSpacePos = worldSpacePos.xyz;",
      "\toVert.worldSpaceNorm = normalize(TDDeformNorm(N));",
      "\toVert.color = Cd;",
      "\toVert.uv = uv[0].st;",
      "}",
      ""
    ],
    "description": "TouchDesigner GLSL Material Vertex Shader template"
  },
  "TouchDesigner Raymarching SDF Starter": {
    "prefix": "td-raymarch",
    "body": [
      "// Raymarching Signed Distance Field (SDF) Shader",
      "uniform float uTime;",
      "out vec4 fragColor;",
      "",
      "const int MAX_STEPS = 64;",
      "const float MAX_DIST = 50.0;",
      "const float SURF_DIST = 0.001;",
      "",
      "float sphereSDF(vec3 p, float r) {",
      "\treturn length(p) - r;",
      "}",
      "",
      "float sceneSDF(vec3 p) {",
      "\t// Repeat or position sphere",
      "\treturn sphereSDF(p - vec3(0.0, 0.0, 3.0), 1.0);",
      "}",
      "",
      "vec3 calcNormal(vec3 p) {",
      "\tfloat d = sceneSDF(p);",
      "\tvec2 e = vec2(0.001, 0.0);",
      "\treturn normalize(vec3(",
      "\t\tsceneSDF(p + e.xyy) - d,",
      "\t\tsceneSDF(p + e.yxy) - d,",
      "\t\tsceneSDF(p + e.yyx) - d",
      "\t));",
      "}",
      "",
      "void main()",
      "{",
      "\t// Centered aspect-corrected coordinates [-1, 1]",
      "\tvec2 uv = (vUV.st - 0.5) * 2.0;",
      "\tuv.x *= uTDOutputInfo.res.x / uTDOutputInfo.res.y;",
      "",
      "\tvec3 ro = vec3(0.0, 0.0, 0.0); // Camera origin",
      "\tvec3 rd = normalize(vec3(uv, 1.0)); // Ray direction",
      "",
      "\tfloat dist = 0.0;",
      "\tvec3 color = vec3(0.05); // Background",
      "",
      "\tfor (int i = 0; i < MAX_STEPS; i++) {",
      "\t\tvec3 p = ro + rd * dist;",
      "\t\tfloat d = sceneSDF(p);",
      "\t\tif (d < SURF_DIST) {",
      "\t\t\tvec3 n = calcNormal(p);",
      "\t\t\tvec3 lightDir = normalize(vec3(1.0, 2.0, -1.0));",
      "\t\t\tfloat diff = clamp(dot(n, lightDir), 0.1, 1.0);",
      "\t\t\tcolor = vec3(0.2, 0.6, 0.9) * diff;",
      "\t\t\tbreak;",
      "\t\t}",
      "\t\tdist += d;",
      "\t\tif (dist > MAX_DIST) break;",
      "\t}",
      "",
      "\tfragColor = TDOutputSwizzle(vec4(color, 1.0));",
      "}",
      ""
    ],
    "description": "TouchDesigner Raymarching / Signed Distance Field starter template"
  },
  "TouchDesigner Feedback Loop": {
    "prefix": "td-feedback",
    "body": [
      "// Multi-Frame Feedback Trail / Decay Shader",
      "// Input 0: Live camera / generative source",
      "// Input 1: Feedback loop TOP",
      "",
      "uniform float uFeedbackAmount; // e.g. 0.95",
      "uniform float uDecay;          // e.g. 0.01",
      "",
      "out vec4 fragColor;",
      "",
      "void main()",
      "{",
      "\tvec2 uv = vUV.st;",
      "\tvec4 currentFrame = texture(sTD2DInputs[0], uv);",
      "\tvec4 prevFrame    = texture(sTD2DInputs[1], uv);",
      "",
      "\t// Slight zoom / drift effect on previous frame",
      "\tvec2 centeredUv = (uv - 0.5) * 0.995 + 0.5;",
      "\tvec4 feedback = texture(sTD2DInputs[1], centeredUv) * 0.96;",
      "",
      "\tvec4 finalColor = max(currentFrame, feedback - 0.002);",
      "\tfragColor = TDOutputSwizzle(finalColor);",
      "}",
      ""
    ],
    "description": "TouchDesigner feedback blur & trail shader"
  },
  "TouchDesigner Procedural Noise (FBM)": {
    "prefix": "td-noise",
    "body": [
      "// Procedural Fractal Noise / FBM Shader",
      "uniform float uTime;",
      "out vec4 fragColor;",
      "",
      "float hash(vec2 p) {",
      "\treturn fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);",
      "}",
      "",
      "float noise(vec2 p) {",
      "\tvec2 i = floor(p);",
      "\tvec2 f = fract(p);",
      "\tvec2 u = f * f * (3.0 - 2.0 * f);",
      "\treturn mix(mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),",
      "\t           mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);",
      "}",
      "",
      "float fbm(vec2 p) {",
      "\tfloat v = 0.0;",
      "\tfloat a = 0.5;",
      "\tvec2 shift = vec2(100.0);",
      "\tfor (int i = 0; i < 5; ++i) {",
      "\t\tv += a * noise(p);",
      "\t\tp = p * 2.0 + shift;",
      "\t\ta *= 0.5;",
      "\t}",
      "\treturn v;",
      "}",
      "",
      "void main()",
      "{",
      "\tvec2 uv = vUV.st * 4.0;",
      "\tfloat n = fbm(uv + vec2(uTime * 0.2));",
      "\tvec3 color = vec3(n);",
      "\tfragColor = TDOutputSwizzle(vec4(color, 1.0));",
      "}",
      ""
    ],
    "description": "TouchDesigner procedural fractal noise (FBM) shader"
  },
  "TouchDesigner Chromatic Aberration": {
    "prefix": "td-chromatic",
    "body": [
      "// Chromatic Aberration & Lens Distortion",
      "uniform float uStrength; // e.g. 0.02",
      "out vec4 fragColor;",
      "",
      "void main()",
      "{",
      "\tvec2 uv = vUV.st;",
      "\tvec2 dir = uv - 0.5;",
      "\tfloat dist = length(dir);",
      "",
      "\tfloat offset = dist * 0.015;",
      "\tfloat r = texture(sTD2DInputs[0], uv - dir * offset).r;",
      "\tfloat g = texture(sTD2DInputs[0], uv).g;",
      "\tfloat b = texture(sTD2DInputs[0], uv + dir * offset).b;",
      "\tfloat a = texture(sTD2DInputs[0], uv).a;",
      "",
      "\tfragColor = TDOutputSwizzle(vec4(r, g, b, a));",
      "}",
      ""
    ],
    "description": "TouchDesigner RGB chromatic aberration shader"
  },
  "TouchDesigner Compute Shader Template": {
    "prefix": "td-compute",
    "body": [
      "// TouchDesigner GLSL Compute TOP Shader",
      "layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;",
      "",
      "void main()",
      "{",
      "\tivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);",
      "\tivec2 outputRes = uTDOutputInfo.res.xy;",
      "",
      "\tif (pixelCoord.x >= outputRes.x || pixelCoord.y >= outputRes.y) return;",
      "",
      "\tvec4 inColor = texelFetch(sTD2DInputs[0], pixelCoord, 0);",
      "\tvec4 outColor = inColor;",
      "",
      "\timageStore(mTDComputeOutputs[0], pixelCoord, TDOutputSwizzle(outColor));",
      "}",
      ""
    ],
    "description": "TouchDesigner GLSL Compute TOP shader template"
  }
}
